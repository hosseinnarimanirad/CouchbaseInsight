<Window x:Class="CouchbaseInsight.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export collection"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}">
    <StackPanel Margin="20,18,20,16">
        <TextBlock Text="Export collection" Style="{StaticResource Text.Title}" />
        <TextBlock x:Name="TargetText" Style="{StaticResource Text.Mono}" Margin="0,4,0,14"
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}" />

        <!-- Shown only when an unfinished export of this collection is on disk. -->
        <Border x:Name="ResumePanel" Visibility="Collapsed" Margin="0,0,0,14" Padding="12,10"
                CornerRadius="6" Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ResumeText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                <CheckBox x:Name="ResumeBox" Style="{StaticResource Switch}" Margin="0,8,0,0"
                          HorizontalAlignment="Left" IsChecked="True"
                          Content="Resume it (off: discard it and start over)"
                          Checked="Resume_OnChanged" Unchecked="Resume_OnChanged" />
            </StackPanel>
        </Border>

        <TextBlock Text="Date field" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
        <ComboBox x:Name="DateFieldBox" IsEditable="True" Style="{StaticResource ComboBox.Mono}"
                  AutomationProperties.Name="Date field" />
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,14"
                   Text="The export reports the first and last value of this field for each class (when the class's documents were created). Guessed from the collection; a dotted path works for a nested field. Leave it empty to skip dates." />

        <TextBlock Text="Save to" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
        <DockPanel>
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0"
                    Style="{StaticResource Button.Secondary}" Click="Browse_OnClick" />
            <TextBox x:Name="PathBox" Style="{StaticResource TextBox.Mono}" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Save to" />
        </DockPanel>

        <TextBlock x:Name="BatchText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,14,0,0" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" />
            <Button x:Name="StartButton" Content="Start export" Margin="8,0,0,0" IsDefault="True"
                    Style="{StaticResource Button.Primary}" Click="Start_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
