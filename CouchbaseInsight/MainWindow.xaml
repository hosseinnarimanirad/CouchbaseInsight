<Window x:Class="CouchbaseInsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:v="clr-namespace:CouchbaseInsight.Views"
        Title="Couchbase Insight"
        Icon="/Assets/app.ico"
        Height="820" Width="1280" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True" >

    <!--
        The window draws its own caption. The title strip is the busiest row in the app — brand,
        which cluster is connected, the connection form toggle, the theme switch — and a native
        title bar above it would be a second, emptier strip saying only the app's name.
        CaptionHeight makes that strip draggable and double-click-to-maximise for free; the controls
        sitting on it opt out with WindowChrome.IsHitTestVisibleInChrome.

        GlassFrameThickness is 1, not 0: any non-zero frame keeps the DWM frame alive, and with it
        the drop shadow (and, on Windows 11, the rounded corners and native border that
        MainWindow.xaml.cs colours). At 0 the window is a bare rectangle, and a white one
        disappears against a white desktop.
    -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunQueryCommand}" />
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding RunQueryCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- The two editors. AvalonEdit is a control, so everything above the text is stylable
             here; the brushes below the control — selection, caret, current line — are not, and
             live in Views/Editors.cs instead. -->
        <Style x:Key="Editor" TargetType="{x:Type ae:TextEditor}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- The chevron between two steps of the keyspace picker. -->
        <Style x:Key="Chevron" TargetType="{x:Type TextBlock}">
            <Setter Property="Text" Value="&#xE76C;" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================= Title bar ========================= -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Wordmark. The only red in the app: everything else that could be red means
                     something failed. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <!-- The app icon itself, so the title bar, taskbar and .exe show one mark.
                         The .ico carries a 20px frame drawn for this size. -->
                    <Image Source="/Assets/app.ico" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="Couchbase Insight" Style="{StaticResource Text.Title}"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <!-- Connection state. Green dot and host once connected, grey and a prompt before. -->
                <Border Grid.Column="1" Style="{StaticResource Pill}" Margin="14,0,0,0" Padding="9,3">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.TextTertiary}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource Pill.Text}" Margin="7,0,0,0"
                                   Text="{Binding ConnectionSummary}"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}" />
                        <TextBlock Style="{StaticResource Pill.Text}" Margin="7,0,0,0"
                                   Text="Not connected"
                                   Visibility="{Binding IsConnected, Converter={StaticResource NotBoolVis}}" />
                    </StackPanel>
                </Border>

                <!-- Column 2 is empty on purpose: it is the drag handle for the window. -->

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.Small}" Margin="0,0,8,0"
                            Command="{Binding ToggleConnectionPanelCommand}"
                            ToolTip="Show or hide the connection form">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE839;" FontFamily="{StaticResource Font.Icons}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="Connection" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Margin="0,0,4,0"
                            Command="{Binding OpenOptionsCommand}" Content="&#xE713;"
                            AutomationProperties.Name="Options"
                            ToolTip="Options: batch size for whole-collection reads" />
                    <Button x:Name="ThemeButton" Style="{StaticResource Button.Icon}" Margin="0,0,4,0"
                            Click="ThemeButton_OnClick" Content="&#xE706;"
                            ToolTip="Switch between the light and dark theme" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.Caption}" Content="&#xE921;"
                            Click="Minimise_OnClick" ToolTip="Minimise" />
                    <Button x:Name="MaximiseButton" Style="{StaticResource Button.Caption}"
                            Content="&#xE922;" Click="MaximiseRestore_OnClick" ToolTip="Maximise" />
                    <Button Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;"
                            Click="Close_OnClick" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================== Body ============================ -->
        <DockPanel Grid.Row="1" Margin="12,10,12,0">

            <!-- Connection form: open on launch, folded away once connected -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10"
                    Visibility="{Binding IsConnectionPanelOpen, Converter={StaticResource BoolVis}}">
                <StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="SAVED" Style="{StaticResource Text.Label}" />
                        <ComboBox Grid.Column="1" AutomationProperties.Name="Saved connection"
                                  ItemsSource="{Binding SavedConnections}"
                                  SelectedItem="{Binding SelectedConnection}"
                                  VerticalAlignment="Center" Tag="No saved connections"
                                  ToolTip="Pick a saved connection to load its details, then Connect." />

                        <TextBlock Grid.Column="2" Text="NAME" Style="{StaticResource Text.Label}"
                                   Margin="14,0,7,0" />
                        <TextBox Grid.Column="3" VerticalAlignment="Center" AutomationProperties.Name="Connection name"
                                 Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. staging"
                                 ToolTip="Name under which Save stores the current details." />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="Save" MinWidth="76" Command="{Binding SaveConnectionCommand}" />
                            <Button Content="Delete" MinWidth="76" Margin="6,0,0,0"
                                    Style="{StaticResource Button.Danger}"
                                    Command="{Binding DeleteConnectionCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="CLUSTER" Style="{StaticResource Text.Label}" />
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small.Icon}"
                                    Content="&#xE8C8;" Margin="4,0,0,0"
                                    AutomationProperties.Name="Copy connection string"
                                    Command="{Binding CopyConnectionStringCommand}"
                                    ToolTip="Copy the connection string" />
                            <TextBox Style="{StaticResource TextBox.Mono}"
                                     VerticalAlignment="Center" AutomationProperties.Name="Connection string"
                                     Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="couchbases://host1,host2" />
                        </DockPanel>

                        <TextBlock Grid.Column="2" Text="USER" Style="{StaticResource Text.Label}"
                                   Margin="14,0,7,0" />
                        <TextBox Grid.Column="3" VerticalAlignment="Center" AutomationProperties.Name="User"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Column="4" Text="PASSWORD" Style="{StaticResource Text.Label}"
                                   Margin="14,0,7,0" />
                        <PasswordBox Grid.Column="5" x:Name="PasswordBox" AutomationProperties.Name="Password"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"
                                     VerticalAlignment="Center" />

                        <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="14,0,0,0">
                            <CheckBox Style="{StaticResource Switch}"
                                      Content="External network"
                                      IsChecked="{Binding UseNetworkResolutionExternal}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="Tick when connecting through a public IP or an SSH tunnel, so the SDK uses the cluster's external alternate addresses." />
                            <Button Content="Connect" MinWidth="86" Style="{StaticResource Button.Primary}"
                                    Command="{Binding ConnectCommand}" />
                            <Button Content="Disconnect" MinWidth="86" Margin="6,0,0,0"
                                    Command="{Binding DisconnectCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Seed hosts, connection-string warnings, the nodes the cluster actually
                         advertised, and the unwrapped exception chain. -->
                    <Expander Margin="0,10,0,0" IsExpanded="False"
                              Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolVis}}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Diagnostics" Style="{StaticResource Text.Heading}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="seed hosts, resolved nodes, exception chain" />
                            </StackPanel>
                        </Expander.Header>
                        <Grid Margin="0,6,0,0">
                            <Border Style="{StaticResource Card.Flush}"
                                    Background="{DynamicResource Brush.SurfaceAlt}">
                                <TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True"
                                         Style="{StaticResource TextBox.Mono}"
                                         Background="Transparent" BorderThickness="0"
                                         MaxHeight="190" Padding="10,8"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Border>
                            <Button Style="{StaticResource Button.Small.Icon}" Content="&#xE8C8;"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,14,0"
                                    Command="{Binding CopyDiagnosticsCommand}"
                                    ToolTip="Copy the report — this is what to paste when reporting a connection problem" />
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Keyspace picker: the path down to the documents being read, and what to do with them.
                 Row 1 is the path and the actions; row 2 is how much of it is read and how big it is;
                 the activity lines below appear only while something long is running. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,8"
                    Margin="0,0,0,10">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding Buckets}" Tag="Bucket"
                              AutomationProperties.Name="Bucket"
                              SelectedItem="{Binding SelectedBucket}" VerticalAlignment="Center"
                              ToolTip="Bucket" />

                    <TextBlock Grid.Column="1" Style="{StaticResource Chevron}" />

                    <ComboBox Grid.Column="2" ItemsSource="{Binding Scopes}" Tag="Scope"
                              AutomationProperties.Name="Scope"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedScope}" VerticalAlignment="Center"
                              ToolTip="Scope" />

                    <TextBlock Grid.Column="3" Style="{StaticResource Chevron}" />

                    <ComboBox Grid.Column="4" ItemsSource="{Binding Collections}" Tag="Collection"
                              AutomationProperties.Name="Collection"
                              SelectedItem="{Binding SelectedCollection}" VerticalAlignment="Center"
                              ToolTip="Collection" />

                    <TextBlock Grid.Column="5" Style="{StaticResource Chevron}" />

                    <ComboBox Grid.Column="6" IsEditable="True" AutomationProperties.Name="Discriminator"
                              Style="{StaticResource ComboBox.Mono}"
                              ItemsSource="{Binding DiscriminatorFields}"
                              Text="{Binding Discriminator, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center"
                              ToolTip="Discriminator — the field whose distinct values are the classes (class, type, _class…). Pick one of the collection's properties or type your own." />

                    <Button Grid.Column="7" Content="Load" Margin="10,0,0,0"
                            ToolTip="Step 1: count every class over the whole collection, on the server; no document is downloaded. Then select a class to list its fields from a small sample, tick fields and press Analyze selected."
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding LoadClassesCommand}" />

                    <Button Grid.Column="8" Content="Deep load" Margin="6,0,0,0"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Download the documents (up to the scan limit) and summarise everything in the app: every field of every class, values, samples, first/last seen, TTL, key shapes. Thorough, but limited by the network."
                            Command="{Binding DeepLoadCommand}" />

                    <Button Grid.Column="9" Content="Export…" Margin="6,0,0,0"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ExportCommand}"
                            ToolTip="Save what Load gathered as a JSON summary. Reads nothing; available after a Load." />

                    <Button Grid.Column="10" Content="Open export…" Margin="6,0,0,0"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding OpenExportFileCommand}"
                            ToolTip="Show a saved export (or an unfinished export's checkpoint) in the Schema explorer, without querying the cluster." />
                </Grid>

                <!-- How much is read, and how big the collection is. -->
                <DockPanel Margin="0,8,0,0">
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}"
                              Content="Scan limit" VerticalAlignment="Center" Margin="0,0,10,0"
                              AutomationProperties.Name="Scan limit on"
                              IsChecked="{Binding IsScanLimitOn}"
                              ToolTip="On: Deep load and Analyze read only the first N documents by key. Off: the whole collection. Load (class counts) always covers every document." />

                    <TextBox DockPanel.Dock="Left" Width="110" Style="{StaticResource TextBox.Mono}"
                             AutomationProperties.Name="Scan limit"
                             Text="{Binding ScanLimit, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsScanLimitOn}"
                             VerticalAlignment="Center"
                             ToolTip="How many documents Load reads while the limit is on: the first N by key. It reads them in pages of the Options batch size. The Query tab is not limited." />

                    <TextBlock DockPanel.Dock="Right" Text="{Binding CollectionSummary}"
                               Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               ToolTip="Document count of the collection, from its item count (no scan)" />

                    <TextBlock Text="{Binding ScanLimitSummary}" Style="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                </StackPanel>
            </Border>

            <!-- Tabs -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex}">

                <!-- ===================== Schema explorer ==================== -->
                <TabItem Header="Schema explorer">
                    <!-- Top: classes | schema, same height. Bottom: values / sample documents, full width. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" MinWidth="280" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" MinWidth="420" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="140" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" MinHeight="90" />
                        </Grid.RowDefinitions>

                        <!-- Classes -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card.Flush}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                Margin="6,0,0,0"
                                                Visibility="{Binding Classes.Count, Converter={StaticResource PositiveVis}}">
                                            <TextBlock Style="{StaticResource Pill.Text}"
                                                       Text="{Binding Classes.Count}" />
                                        </Border>
                                        <TextBlock Text="Classes" Style="{StaticResource Text.Heading}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border DockPanel.Dock="Top" Padding="8,8,8,4">
                                    <TextBox Style="{StaticResource TextBox.Search}" Tag="Filter classes"
                                             AutomationProperties.Name="Filter classes"
                                             Text="{Binding ClassFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding Classes.Count, Converter={StaticResource PositiveVis}}" />
                                </Border>

                                <DockPanel DockPanel.Dock="Top" Margin="12,0,8,2"
                                           Visibility="{Binding OfflineSource, Converter={StaticResource NotEmptyVis}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small.Icon}"
                                            Content="&#xE711;" VerticalAlignment="Top"
                                            AutomationProperties.Name="Close file"
                                            Command="{Binding CloseExportFileCommand}"
                                            ToolTip="Close the file and go back to the cluster" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               VerticalAlignment="Center"
                                               Text="{Binding OfflineSource}" />
                                </DockPanel>

                                <TextBlock DockPanel.Dock="Top" Margin="12,0,12,4"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="{Binding ClassesCaption}"
                                           Visibility="{Binding ClassesCaption, Converter={StaticResource NotEmptyVis}}" />

                                <Button DockPanel.Dock="Top" Margin="12,0,12,6" HorizontalAlignment="Left"
                                        Style="{StaticResource Button.Small}"
                                        Content="Analyze all classes"
                                        Command="{Binding AnalyzeAllClassesCommand}"
                                        Visibility="{Binding IsTwoStep, Converter={StaticResource BoolVis}}"
                                        ToolTip="Everything for every class: lists the fields of each class not yet listed (fetched by key, no search), ticks every field that never holds an object or an array, and counts them all in one pass on the server. Export then holds the whole collection. Follows the scan-limit switch." />

                                <Button DockPanel.Dock="Top" Margin="12,0,12,6" HorizontalAlignment="Left"
                                        Style="{StaticResource Button.Small}"
                                        Content="Count every class exactly"
                                        Command="{Binding CountExactlyCommand}"
                                        Visibility="{Binding CanCountExactly, Converter={StaticResource BoolVis}}"
                                        ToolTip="Counts every class over the whole collection on the server, one batch at a time; only the counts come back. The schema and values stay those of the documents Load read. Classes that none of those documents had appear with a count only." />


                                <Grid>
                                    <ListBox Style="{StaticResource EntryList}" AutomationProperties.Name="Classes"
                                             ItemsSource="{Binding ClassesView}"
                                             SelectedItem="{Binding SelectedClassEntry}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel ToolTip="{Binding Tip}">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Margin="0,0,7,0"
                                                               VerticalAlignment="Center" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="sampled">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="partly analyzed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="analyzed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="loaded">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                                               Style="{StaticResource Text.MonoCaption}"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding CountText}" />
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding Classes.Count, Converter={StaticResource ZeroVis}}">
                                        <TextBlock Style="{StaticResource Glyph.Placeholder}" Text="&#xE8EC;" />
                                        <TextBlock Style="{StaticResource Text.Placeholder}"
                                                   Text="Pick a bucket, scope and collection above, then Load." />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Row="0" Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />

                        <!-- Schema -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card.Flush}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                                                    Visibility="{Binding IsTwoStep, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Select" Style="{StaticResource Text.Secondary}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Content="Scalars" Style="{StaticResource Button.Small}" Margin="0,0,4,0"
                                                    Command="{Binding SelectScalarFieldsCommand}"
                                                    ToolTip="Tick every field except objects and arrays (their values are large and rarely worth counting)" />
                                            <Button Content="All" Style="{StaticResource Button.Small}" Margin="0,0,4,0"
                                                    Command="{Binding SelectAllFieldsCommand}" />
                                            <Button Content="None" Style="{StaticResource Button.Small}" Margin="0,0,10,0"
                                                    Command="{Binding SelectNoFieldsCommand}" />
                                            <Button Style="{StaticResource Button.Primary}"
                                                    Command="{Binding AnalyzeSelectedCommand}"
                                                    ToolTip="Count the ticked fields in every class at once, on the server, in one pass (over the whole collection, or the first N documents while the scan limit is on): exact presence, top 50 values with counts, distinct count, min and max. Only the counts come back. Ticks are by field name, so they carry across classes.">
                                                <TextBlock>
                                                    <Run Text="Analyze selected (" /><Run Text="{Binding SelectedFieldCount, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                            </Button>
                                        </StackPanel>

                                        <TextBox DockPanel.Dock="Right" Width="170"
                                                 Style="{StaticResource TextBox.Search}"
                                                 Tag="Filter fields" Margin="8,0,0,0" AutomationProperties.Name="Filter fields"
                                                 Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding HasSchema, Converter={StaticResource BoolVis}}" />

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Schema" Style="{StaticResource Text.Heading}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Text.Mono}" Margin="8,0,12,0"
                                                       VerticalAlignment="Center" MaxWidth="220"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       Text="{Binding AnalyzedClass}"
                                                       ToolTip="{Binding AnalyzedClass}" />

                                            <!-- The headline numbers, one pill each. -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasSchema, Converter={StaticResource BoolVis}}">
                                                <Border Style="{StaticResource Pill}">
                                                    <TextBlock Style="{StaticResource Pill.Text}">
                                                        <Run Text="{Binding FieldCount, Mode=OneWay}" /><Run Text=" fields" />
                                                    </TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource Pill}"
                                                        Background="{DynamicResource Brush.OkSoft}">
                                                    <TextBlock Style="{StaticResource Pill.Text}"
                                                               Foreground="{DynamicResource Brush.Ok}">
                                                        <Run Text="{Binding RequiredCount, Mode=OneWay}" /><Run Text=" required" />
                                                    </TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource Pill}"
                                                        Background="{DynamicResource Brush.WarnSoft}"
                                                        Visibility="{Binding IssueCount, Converter={StaticResource PositiveVis}}"
                                                        ToolTip="Fields whose name collides with another only by case, or that were seen with more than one JSON type">
                                                    <TextBlock Style="{StaticResource Pill.Text}"
                                                               Foreground="{DynamicResource Brush.Warn}">
                                                        <Run Text="{Binding IssueCount, Mode=OneWay}" /><Run Text=" flagged" />
                                                    </TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource Pill}"
                                                        ToolTip="Documents read to infer this schema">
                                                    <TextBlock Style="{StaticResource Pill.Text}">
                                                        <Run Text="{Binding SampleSize, Mode=OneWay}" /><Run Text=" docs sampled" />
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Grid>
                                    <DataGrid AutomationProperties.Name="Fields" ItemsSource="{Binding FieldsView}"
                                              SelectedItem="{Binding SelectedField}">
                                        <DataGrid.Columns>

                                            <DataGridTemplateColumn Header="" Width="46">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                                      VerticalAlignment="Center"
                                                                      AutomationProperties.Name="Analyze this field"
                                                                      ToolTip="Tick to count this field over every document of the class" />
                                                            <TextBlock Text="&#x2713;" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Brush.Ok}"
                                                                       Visibility="{Binding IsAnalyzed, Converter={StaticResource BoolVis}}"
                                                                       ToolTip="Counted over every document of the class: presence and values are exact" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Field" Width="2.2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- Parent path dimmed, leaf at full contrast: ten nested
                                                             fields under one object are then ten distinct names
                                                             rather than ten copies of their prefix. -->
                                                        <TextBlock Style="{StaticResource Text.Mono}"
                                                                   ToolTip="{Binding Name}">
                                                            <Run Foreground="{DynamicResource Brush.TextTertiary}"
                                                                 Text="{Binding Name, Mode=OneWay, Converter={StaticResource PathPrefix}}" /><Run
                                                                 Text="{Binding Name, Mode=OneWay, Converter={StaticResource PathLeaf}}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Type" Width="1.5*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ItemsControl ItemsSource="{Binding Types, Converter={StaticResource Csv}}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource TypeBadge}">
                                                                        <TextBlock Style="{StaticResource TypeBadge.Text}"
                                                                                   Text="{Binding}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Presence" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                    ToolTip="{Binding Occurrences, StringFormat='Seen in {0} of the sampled documents'}">
                                                            <Grid>
                                                                <Border Style="{StaticResource PresenceTrack}" />
                                                                <Border Style="{StaticResource PresenceFill}"
                                                                        Width="{Binding PresencePercent, Mode=OneWay,
                                                                                        Converter={StaticResource PercentWidth},
                                                                                        ConverterParameter=54}" />
                                                            </Grid>
                                                            <TextBlock Style="{StaticResource Text.Mono}" Margin="9,0,0,0"
                                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                                       Text="{Binding PresencePercent, StringFormat={}{0:F1}%}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Seen" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource Text.Mono}"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   Text="{Binding Occurrences}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Requirement" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                                    <Setter Property="Margin" Value="0" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                                            <Setter Property="Background"
                                                                                    Value="{DynamicResource Brush.OkSoft}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding RequirementLabel}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Pill.Text}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                                                <Setter Property="Foreground"
                                                                                        Value="{DynamicResource Brush.Ok}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Flags" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Style="{StaticResource Pill}"
                                                                    Background="{DynamicResource Brush.WarnSoft}"
                                                                    Visibility="{Binding HasCaseDuplicate, Converter={StaticResource BoolVis}}"
                                                                    ToolTip="Another field has the same name under a different casing — the two are separate fields to the server">
                                                                <TextBlock Style="{StaticResource Pill.Text}"
                                                                           Foreground="{DynamicResource Brush.Warn}"
                                                                           Text="case conflict" />
                                                            </Border>
                                                            <Border Style="{StaticResource Pill}"
                                                                    Background="{DynamicResource Brush.WarnSoft}"
                                                                    Visibility="{Binding HasMultipleTypes, Converter={StaticResource BoolVis}}"
                                                                    ToolTip="Seen with more than one JSON type across the sampled documents">
                                                                <TextBlock Style="{StaticResource Pill.Text}"
                                                                           Foreground="{DynamicResource Brush.Warn}"
                                                                           Text="multi-type" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>


                                            <DataGridTemplateColumn Header="Values" Width="Auto" MinWidth="96">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Top 50" Style="{StaticResource Button.Small}" Padding="10,2" MinWidth="72"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                AutomationProperties.Name="Count this field's values"
                                                                Command="{Binding DataContext.AnalyzeFieldCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Count this field's values in every class (one pass, on the server) and show its top 50 with counts, distinct count, min and max. Follows the scan-limit switch." />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding FieldCount, Converter={StaticResource ZeroVis}}">
                                        <TextBlock Style="{StaticResource Glyph.Placeholder}" Text="&#xE9D5;" />
                                        <TextBlock Style="{StaticResource Text.Placeholder}"
                                                   Text="Load, then select a class. Every field found in its documents is listed with the types it was seen as and how often it appeared." />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="10" ResizeDirection="Rows"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />

                        <!-- Values of the selected field / sample documents of the selected class, one tab each -->
                        <TabControl Grid.Row="2" Grid.ColumnSpan="3" SelectedIndex="{Binding DetailTabIndex}">
                            <TabItem Header="Distinct values">
                                <Border Style="{StaticResource Card.Flush}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small.Icon}"
                                                        Content="&#xE8C8;" Margin="6,0,0,0"
                                                        Command="{Binding CopyDistinctValuesCommand}"
                                                        Visibility="{Binding DistinctValues.Count, Converter={StaticResource PositiveVis}}"
                                                        ToolTip="Copy every value listed" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}"
                                                        Content="Open example" Margin="6,0,0,0"
                                                        Command="{Binding OpenValueExampleCommand}"
                                                        Visibility="{Binding DistinctValues.Count, Converter={StaticResource PositiveVis}}"
                                                        ToolTip="Open a document that holds the selected value, in the Query tab" />
                                                <TextBlock Text="{Binding DistinctValuesHeader}"
                                                           Style="{StaticResource Text.Heading}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DistinctValuesHeader}" />
                                            </DockPanel>
                                        </Border>

                                        <Grid>
                                            <ListBox Style="{StaticResource ValueList}" AutomationProperties.Name="Distinct values"
                                                     ItemsSource="{Binding DistinctValues}"
                                                     SelectedItem="{Binding SelectedDistinctValue}"
                                                     DisplayMemberPath="Text" />

                                            <TextBlock Style="{StaticResource Text.Placeholder}"
                                                       Visibility="{Binding DistinctValues.Count, Converter={StaticResource ZeroVis}}"
                                                       Text="Click a field above to see the values it actually holds." />
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </TabItem>

                            <TabItem Header="Sample documents">
                                <Border Style="{StaticResource Card.Flush}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}"
                                                        Content="Open in Query tab" Margin="6,0,0,0"
                                                        Command="{Binding OpenSampleInQueryCommand}"
                                                        ToolTip="Put SELECT … USE KEYS for this document in the Query tab" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}"
                                                        Content="Copy key" Margin="6,0,0,0"
                                                        Command="{Binding CopySampleKeyCommand}" />
                                                <TextBlock Text="{Binding SampleDocumentsHeader}"
                                                           Style="{StaticResource Text.Heading}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SampleDocumentsHeader}" />
                                            </DockPanel>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="140" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>

                                            <ListBox Grid.Column="0" Style="{StaticResource ValueList}"
                                                     AutomationProperties.Name="Sample document keys"
                                                     ItemsSource="{Binding SampleDocuments}"
                                                     SelectedItem="{Binding SelectedSampleDocument}"
                                                     DisplayMemberPath="Display" />

                                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch" />

                                            <TextBox Grid.Column="2" Style="{StaticResource TextBox.Mono}"
                                                     AutomationProperties.Name="Sample document"
                                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding SelectedSampleDocument.Json, Mode=OneWay}" />

                                            <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Text.Placeholder}"
                                                       Visibility="{Binding SampleDocuments.Count, Converter={StaticResource ZeroVis}}"
                                                       Text="Pick a collection to see its first documents, or a class to see documents from its sample." />
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <!-- ========================= Query ========================= -->
                <TabItem Header="Query">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <!-- Statement builder -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>

                                <!-- Builder mode: SELECT / FROM, then a condition at a time. -->
                                <StackPanel Visibility="{Binding IsRawQuery, Converter={StaticResource NotBoolVis}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="SELECT" Style="{StaticResource Text.Label}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Mono}" AutomationProperties.Name="Select expression"
                                                 Margin="0,0,14,0" VerticalAlignment="Center"
                                                 Text="{Binding SelectExpression, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Column="2" Text="FROM" Style="{StaticResource Text.Label}" />
                                        <TextBox Grid.Column="3" Style="{StaticResource TextBox.Mono}" AutomationProperties.Name="From keyspace"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding FromKeyspace, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="`bucket`.`scope`.`collection`"
                                                 ToolTip="Backticks around each identifier: `bucket`.`scope`.`collection`" />

                                        <Button Grid.Column="4" Content="Sync from selection" Margin="10,0,0,0"
                                                Command="{Binding SyncFromSelectionCommand}"
                                                ToolTip="Fill FROM and WHERE from the keyspace picker above, and load that collection's fields into the condition builder" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="WHERE" Style="{StaticResource Text.Label}" />
                                        <ComboBox Grid.Column="1" AutomationProperties.Name="Condition field" ItemsSource="{Binding QueryFields}"
                                                  DisplayMemberPath="Name" Tag="Field"
                                                  Style="{StaticResource ComboBox.Mono}"
                                                  SelectedItem="{Binding PendingWhereField}"
                                                  ToolTip="Fields discovered by Sync from selection" />
                                        <ComboBox Grid.Column="2" Margin="6,0" AutomationProperties.Name="Condition operator"
                                                  ItemsSource="{Binding WhereOperators}"
                                                  SelectedItem="{Binding PendingWhereOperator}" />
                                        <TextBox Grid.Column="3" Style="{StaticResource TextBox.Mono}" AutomationProperties.Name="Condition value"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Text="{Binding PendingWhereValue, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding WhereValueEnabled}"
                                                 Tag="value" />
                                        <Button Grid.Column="4" Content="Add" MinWidth="58"
                                                Command="{Binding AddWhereConditionCommand}"
                                                ToolTip="Append this condition to the clause below, quoted the way its value needs" />
                                        <Button Grid.Column="5" Content="Clear" MinWidth="58" Margin="6,0,0,0"
                                                Command="{Binding ClearWhereCommand}" />
                                    </Grid>

                                    <Border Style="{StaticResource Card.Flush}" MinHeight="62" MaxHeight="130"
                                            Background="{DynamicResource Brush.Surface}">
                                        <ae:TextEditor Style="{StaticResource Editor}"
                                                       AutomationProperties.Name="Where clause"
                                                       v:Editors.Syntax="N1ql"
                                                       v:Editors.Text="{Binding WhereClause, Mode=TwoWay,
                                                                                UpdateSourceTrigger=PropertyChanged}"
                                                       ToolTip="Built by the row above, or typed here directly" />
                                    </Border>
                                </StackPanel>

                                <!-- Raw mode: the whole statement, by hand. -->
                                <Border Style="{StaticResource Card.Flush}" MinHeight="130"
                                        Background="{DynamicResource Brush.Surface}"
                                        Visibility="{Binding IsRawQuery, Converter={StaticResource BoolVis}}">
                                    <ae:TextEditor Style="{StaticResource Editor}"
                                                   ShowLineNumbers="True"
                                                   v:Editors.Syntax="N1ql"
                                                   v:Editors.Text="{Binding RawStatement, Mode=TwoWay,
                                                                            UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- What will run, and the buttons that run it -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Run query" MinWidth="110"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding RunQueryCommand}"
                                        ToolTip="Run the statement (F5)" />
                                <Button Content="Cancel" MinWidth="80" Margin="6,0,0,0"
                                        Style="{StaticResource Button.Danger}"
                                        Command="{Binding CancelQueryCommand}"
                                        Visibility="{Binding IsQueryRunning, Converter={StaticResource BoolVis}}" />
                                <CheckBox Style="{StaticResource Switch}" Margin="10,0,0,0"
                                          Content="Edit as SQL++"
                                          IsChecked="{Binding IsRawQuery}"
                                          VerticalAlignment="Center"
                                          ToolTip="Hand the composed statement to a free-text editor, for everything the builder cannot express — JOIN, ORDER BY, LIMIT, subqueries." />
                            </StackPanel>

                            <!-- The exact text that will be sent. The builder shows its parts; this
                                 shows the whole, which is what a server error will refer to. -->
                            <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="7" Padding="10,5"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    Visibility="{Binding IsRawQuery, Converter={StaticResource NotBoolVis}}">
                                <TextBlock Style="{StaticResource Text.MonoCaption}"
                                           VerticalAlignment="Center"
                                           Text="{Binding QueryPreview}"
                                           ToolTip="{Binding QueryPreview}" />
                            </Border>

                            <Button Grid.Column="2" Style="{StaticResource Button.Small.Icon}"
                                    Content="&#xE8C8;" Margin="8,0,0,0"
                                    Command="{Binding CopyStatementCommand}"
                                    ToolTip="Copy the statement" />
                        </Grid>

                        <!-- Result -->
                        <Border Grid.Row="2" Style="{StaticResource Card.Flush}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small.Icon}"
                                                Content="&#xE8C8;" Margin="6,0,0,0"
                                                Command="{Binding CopyQueryResultCommand}"
                                                ToolTip="Copy the JSON" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                Background="{DynamicResource Brush.InfoSoft}"
                                                Visibility="{Binding QueryResult, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Style="{StaticResource Pill.Text}"
                                                       Foreground="{DynamicResource Brush.Info}">
                                                <Run Text="{Binding QueryRowCount, Mode=OneWay}" /><Run Text=" rows" />
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="Result" Style="{StaticResource Text.Heading}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Grid>
                                    <ae:TextEditor Style="{StaticResource Editor}"
                                                   IsReadOnly="True"
                                                   ShowLineNumbers="True"
                                                   v:Editors.Syntax="Json"
                                                   v:Editors.Text="{Binding QueryResult, Mode=OneWay}" />

                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding QueryResult, Converter={StaticResource EmptyVis}}">
                                        <TextBlock Style="{StaticResource Glyph.Placeholder}" Text="&#xE773;" />
                                        <TextBlock Style="{StaticResource Text.Placeholder}"
                                                   Text="Run a query to see its rows here. Ctrl+F searches the result." />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </DockPanel>

        <!-- ===================== Loading overlay ======================= -->
        <!-- While a load runs for more than a moment, the window below the title bar is dimmed and
             takes no clicks; this card says what is running, how far it is, and offers Cancel. -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="100"
              Visibility="{Binding IsActivityVisible, Converter={StaticResource BoolVis}}">
            <Border Background="{DynamicResource Brush.Window}" Opacity="0.72" />
            <Border Style="{StaticResource Card}" Width="460" Padding="20,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Working…" Style="{StaticResource Text.Heading}" />
                    <TextBlock Text="{Binding ActivityLine}" Style="{StaticResource Text.Mono}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <Grid Margin="0,14,0,0" HorizontalAlignment="Left"
                          Visibility="{Binding HasActivityPercent, Converter={StaticResource BoolVis}}">
                        <Border Width="420" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Track}" />
                        <Border Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Accent}"
                                Width="{Binding ActivityPercent, Converter={StaticResource PercentWidth}, ConverterParameter=420}" />
                    </Grid>

                    <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,16,0,0"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding CancelActivityCommand}"
                            Visibility="{Binding IsActivityCancellable, Converter={StaticResource BoolVis}}"
                            ToolTip="Stop it. A batched read keeps and shows what it counted so far." />
                    <TextBlock Text="This step cannot be cancelled; it finishes on its own."
                               Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                               Visibility="{Binding IsActivityCancellable, Converter={StaticResource NotBoolVis}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================= Status bar ======================== -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="14,0" Height="30">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Style="{StaticResource Busy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />

                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,9,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.TextTertiary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Busy">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Ok">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Ok}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Error">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock VerticalAlignment="Center" Text="{Binding Status}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>

</Window>
