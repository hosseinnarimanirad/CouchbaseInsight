<Window x:Class="CouchbaseInsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Couchbase Insight" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="IssuesCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8B6914" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Width="120" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Connection panel -->
        <GroupBox DockPanel.Dock="Top" Header="Connection" Padding="8">
          <StackPanel>

            <!-- Saved connections bar -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Saved" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding SavedConnections}"
                          SelectedItem="{Binding SelectedConnection}" VerticalAlignment="Center"
                          ToolTip="Pick a saved connection to load its details, then Connect." />

                <TextBlock Grid.Column="2" Text="Name" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Grid.Column="3" Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         ToolTip="Name under which Save stores the current details." />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Save" Width="70" Command="{Binding SaveConnectionCommand}" />
                    <Button Content="Delete" Width="70" Margin="6,0,0,0"
                            Command="{Binding DeleteConnectionCommand}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Connection string" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Text="User" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Grid.Column="3" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />

                <TextBlock Grid.Column="4" Text="Password" VerticalAlignment="Center" Margin="12,0,6,0" />
                <PasswordBox Grid.Column="5" x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             VerticalAlignment="Center" />

                <StackPanel Grid.Column="6" Margin="12,0,0,0">
                    <CheckBox Content="External network (staging/tunnel)"
                              IsChecked="{Binding UseNetworkResolutionExternal}"
                              Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Connect" Width="80" Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect" Width="80" Margin="6,0,0,0"
                                Command="{Binding DisconnectCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
          </StackPanel>
        </GroupBox>

        <!-- Selection panel -->
        <GroupBox DockPanel.Dock="Top" Header="Selection" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Bucket" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Buckets}"
                          SelectedItem="{Binding SelectedBucket}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Text="Scope" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Scopes}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedScope}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="4" Text="Collection" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding Collections}"
                          SelectedItem="{Binding SelectedCollection}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="6" Text="Discriminator" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Grid.Column="7" IsEditable="True"
                          ItemsSource="{Binding DiscriminatorFields}"
                          Text="{Binding Discriminator, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center"
                          ToolTip="Field whose distinct values are the 'classes' (e.g. type, _class, docType). Pick from the collection's properties or type one." />

                <Button Grid.Column="8" Content="Load Classes" Width="100" Margin="12,0,0,0"
                        Command="{Binding LoadClassesCommand}" />
            </Grid>
        </GroupBox>

        <!-- Main content tabs -->
        <TabControl Margin="0,8,0,0">

            <!-- Schema Explorer tab -->
            <TabItem Header="Schema Explorer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Classes -->
                    <GroupBox Header="Classes" Padding="6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <CheckBox Content="Analyze all documents (otherwise top 1000)"
                                          IsChecked="{Binding AnalyzeAll}" Margin="0,0,0,6" />
                                <Button Content="Analyze Structure" Command="{Binding AnalyzeCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Classes}"
                                     SelectedItem="{Binding SelectedClass}" />
                        </DockPanel>
                    </GroupBox>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch" Background="Transparent" />

                    <!-- Right: schema grid + distinct values panel -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="60" />
                        </Grid.RowDefinitions>

                        <!-- Schema DataGrid -->
                        <GroupBox Padding="6">
                            <GroupBox.Header>
                                <TextBlock Text="{Binding SchemaSummary, TargetNullValue='Schema', FallbackValue='Schema'}" />
                            </GroupBox.Header>
                            <DataGrid ItemsSource="{Binding Fields}"
                                      SelectedItem="{Binding SelectedField}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Issues" Binding="{Binding Issues}" Width="Auto"
                                                        ElementStyle="{StaticResource IssuesCellStyle}" />
                                    <DataGridTextColumn Header="Type(s)" Binding="{Binding Types}" Width="*" />
                                    <DataGridTextColumn Header="Requirement" Binding="{Binding RequirementLabel}" Width="Auto" />
                                    <DataGridTextColumn Header="Presence"
                                                        Binding="{Binding PresencePercent, StringFormat={}{0:F1}%}" Width="Auto" />
                                    <DataGridTextColumn Header="Seen" Binding="{Binding Occurrences}" Width="Auto" />
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                <Setter Property="Background" Value="#E8F5E9" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </GroupBox>

                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" Background="Transparent" />

                        <!-- Distinct values panel -->
                        <GroupBox Grid.Row="2" Padding="6">
                            <GroupBox.Header>
                                <TextBlock Text="{Binding DistinctValuesHeader}" />
                            </GroupBox.Header>
                            <ListBox ItemsSource="{Binding DistinctValues}"
                                     FontFamily="Consolas" FontSize="12" />
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Query tab -->
            <TabItem Header="Query">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="100" />
                    </Grid.RowDefinitions>

                    <!-- SELECT … FROM … -->
                    <GroupBox Header="Select" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SELECT" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontWeight="Bold" />
                            <TextBox Grid.Column="1" Margin="6,0"
                                     Text="{Binding SelectExpression, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="FROM" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontWeight="Bold" />
                            <TextBox Grid.Column="3" Margin="6,0"
                                     Text="{Binding FromKeyspace, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalAlignment="Center"
                                     ToolTip="Use backticks for identifiers: `bucket`.`scope`.`collection`" />
                            <Button Grid.Column="4" Content="Sync from Selection" Padding="10,3"
                                    Command="{Binding SyncFromSelectionCommand}"
                                    ToolTip="Fill FROM and WHERE from the Selection pane above" />
                        </Grid>
                    </GroupBox>

                    <!-- WHERE builder -->
                    <GroupBox Grid.Row="1" Header="Where" Padding="6" Margin="0,4,0,0">
                        <DockPanel>
                            <!-- Field picker row -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding QueryFields}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding PendingWhereField}"
                                          ToolTip="Fields discovered by Sync from Selection" />
                                <ComboBox Grid.Column="1" Margin="4,0"
                                          ItemsSource="{Binding WhereOperators}"
                                          SelectedItem="{Binding PendingWhereOperator}" />
                                <TextBox Grid.Column="2" Margin="0,0,4,0"
                                         Text="{Binding PendingWhereValue, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding WhereValueEnabled}"
                                         FontFamily="Consolas" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="Add" Width="50"
                                        Command="{Binding AddWhereConditionCommand}" />
                                <Button Grid.Column="4" Content="Clear" Width="50" Margin="4,0,0,0"
                                        Command="{Binding ClearWhereCommand}" />
                            </Grid>
                            <!-- Editable WHERE text -->
                            <TextBox Text="{Binding WhereClause, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="12"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="44" MaxHeight="110"
                                     ToolTip="Auto-built from the field picker above, or type manually" />
                        </DockPanel>
                    </GroupBox>

                    <!-- Run button + count -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,4">
                        <Button Content="Run Query" Width="100" Command="{Binding RunQueryCommand}" />
                        <TextBlock Text="{Binding QueryResultCountLabel}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontWeight="SemiBold" Foreground="#1565C0" FontSize="13" />
                    </StackPanel>

                    <!-- Result JSON -->
                    <GroupBox Grid.Row="3" Header="Result (JSON)" Padding="4">
                        <TextBox Text="{Binding QueryResult, Mode=OneWay}"
                                 FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 Background="#FAFAFA" />
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>

</Window>
