<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:v="clr-namespace:CouchbaseInsight.Views">

    <!--
        The control library.

        Every colour in here is a DynamicResource. That is what makes the theme switch work:
        ThemeManager swaps the colour dictionary underneath and each template repaints in place,
        with nothing rebuilt and no binding re-evaluated. A StaticResource colour in this file
        would freeze at whichever theme happened to load first, so there are none.

        Layout constants — radius, control height, padding — are literals on purpose. They are the
        shape of the app rather than a theme, and they do not differ between light and dark.
    -->

    <BooleanToVisibilityConverter x:Key="BoolVis" />
    <v:InverseBoolToVisibilityConverter x:Key="NotBoolVis" />
    <v:EmptyToVisibilityConverter x:Key="EmptyVis" />
    <v:NotEmptyToVisibilityConverter x:Key="NotEmptyVis" />
    <v:ZeroToVisibilityConverter x:Key="ZeroVis" />
    <v:PositiveToVisibilityConverter x:Key="PositiveVis" />
    <v:PathPrefixConverter x:Key="PathPrefix" />
    <v:PathLeafConverter x:Key="PathLeaf" />
    <v:CsvToListConverter x:Key="Csv" />
    <v:PercentToWidthConverter x:Key="PercentWidth" />

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Field names, types, values and queries are all read character by character, so all four
         are monospaced wherever they appear. -->
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Size.Mono">12</sys:Double>

    <!-- One height for every interactive control, and one for the dense variants. These are here
         rather than spelled into each style so that a button and the field beside it line up by
         construction rather than by coincidence. -->
    <sys:Double x:Key="Size.Control">30</sys:Double>
    <sys:Double x:Key="Size.Control.Dense">24</sys:Double>

    <!-- ============================== Text ============================== -->

    <Style x:Key="Text.Base" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!--
        There is deliberately no implicit TextBlock style here. An implicit one reaches the TextBlock
        that ContentPresenter creates for a button's string content, and a Foreground setter on it
        would repaint every button label — white-on-accent included — with the window's text colour.
        Plain text inherits Foreground and FontFamily from the window instead; anything that needs
        more names one of the keyed styles above.
    -->

    <Style x:Key="Text.Title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Heading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- The label in front of a field. Small and tertiary, because the value beside it is the thing
         being read: a full-contrast label doubles the number of things competing for the eye on a
         row that already carries four fields. -->
    <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.MonoCaption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Centred, tertiary, wrapped: the "nothing here yet, and here is what to do about it" text
         that stands in for an empty list, grid or result pane. -->
    <Style x:Key="Text.Placeholder" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="Glyph.Placeholder" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Border}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ============================ Surfaces ============================ -->

    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A card that hosts a list or a grid edge to edge: no padding, so the rows reach the corners
         and a header strip can sit flush against the top border. -->
    <Style x:Key="Card.Flush" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- The title strip along the top of a flush card. Radius matches the card's top corners. -->
    <Style x:Key="CardHeader" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="9,9,0,0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The actions that apply to what is in the card, along its bottom edge. -->
    <Style x:Key="CardFooter" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0,0,9,9" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ========================= Pills and badges ======================= -->

    <!--
        A number with a word after it. These replace the run-on summary the schema pane used to
        carry — "24 field(s) (18 required, 6 optional) from 1000 doc(s) | 2 case conflict(s)" — which
        had to be read left to right to find whichever number you were after.
    -->
    <Style x:Key="Pill" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Pill.Text" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!--
        The type badge in the schema grid, coloured by JSON type. The colour is not decoration: the
        column exists to catch a field that is a string in some documents and a number in others,
        and two differently coloured badges on one row say that at a glance, where the text
        "string, number" has to be read first.
    -->
    <Style x:Key="TypeBadge" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="string">
                <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="number">
                <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="boolean">
                <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="null">
                <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TypeBadge.Text" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="string">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="number">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="boolean">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="null">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================= Buttons ============================ -->

    <Style x:Key="Button.Base" TargetType="{x:Type ButtonBase}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="13,4" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Anything unstyled falls back to Secondary rather than to the Windows chrome. -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}" />

    <Style x:Key="Button.Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource Size.Control}" />
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Small, quiet action that sits inside a dense row: copy, clear, sync. -->
    <Style x:Key="Button.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Dense}" />
        <Setter Property="FontSize" Value="11.5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Small.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Small}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="7,2" />
    </Style>

    <!-- Disconnect and Delete. Soft until hover, so it reads as "this is the one that takes
         something away" without shouting from across the window. -->
    <Style x:Key="Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Title-bar buttons. The window draws its own caption (see WindowChrome in MainWindow), so
        these are ordinary buttons that happen to sit where the system ones would: square, flat,
        and 46 wide, which is what Windows uses. Close is the only one that colours on hover.
    -->
    <Style x:Key="Button.Caption" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Caption.Close" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Caption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Input ============================= -->

    <Style x:Key="Field.Base" TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <!-- Vertical padding only has to clear the text; Size.Control decides the height. A
             multi-line field overrides both, and should — a pane is not a row control. -->
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- The hint comes from Tag, the only string a TextBox carries that is
                                 not its value. Without it an empty box is an unexplained rectangle,
                                 and this app has five of them side by side. -->
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <!-- Template-bound rather than fixed: hard-coding these makes one-line
                                 fields look right while leaving a multi-line box unable to scroll
                                 or top-align, whatever it asks for. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Scroll}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Connection strings, keyspaces and values are typed and compared literally. -->
    <Style x:Key="TextBox.Mono" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
    </Style>

    <!-- A filter box above a list. Same field, with the magnifier drawn inside it. -->
    <Style x:Key="TextBox.Search" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Dense}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;"
                                       FontFamily="{StaticResource Font.Icons}" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" Margin="7,0,6,0"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="7,0,6,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Scroll}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The password field, templated to match the text fields exactly. Left unstyled it is the one
         Windows-chrome control on an otherwise themed row, which is precisely where the eye goes. -->
    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Scroll}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Scroll}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Data="M 0,4.2 L 3.2,7.4 L 8.6,1.2"
                                  Stroke="{DynamicResource Brush.OnAccent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A standing mode rather than a one-off choice: "analyze every document" and "external network
        resolution" both change what the next click does, and one left on is why a result looks
        wrong an hour later. A switch says "still on" from across the room in a way a tick box does
        not.
    -->
    <Style x:Key="Switch" TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="Root" CornerRadius="7" Padding="8,0" Background="Transparent"
                            MinHeight="{StaticResource Size.Control.Dense}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="26" Height="15" CornerRadius="8"
                                    Background="{DynamicResource Brush.Track}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="11" Height="11" Margin="2,0,0,0"
                                         Fill="{DynamicResource Brush.Surface}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="7,0,1,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBox.Toggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Root"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Chevron" Text="&#xE70D;"
                                   FontFamily="{StaticResource Font.Icons}" FontSize="9"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" Margin="0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource Field.Base}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboBox.Toggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- All four properties, as in WPF's own template: SelectionBoxItemTemplate
                             is what carries DisplayMemberPath through to the closed combo, and
                             without the pair the box falls back to ToString() on the item. -->
                        <ContentPresenter x:Name="Selected"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <!-- The hint for an empty non-editable combo. Bucket, scope and collection
                             are all empty until the step before them has run, and "Bucket" written
                             faintly inside the box says which step that is. -->
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" Visibility="Collapsed" />

                        <!-- WPF looks this part up by name and drives it itself; a template without
                             it makes IsEditable="True" silently do nothing. It sits on top of the
                             presenter and hides it, so a non-editable combo is unaffected. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="{TemplateBinding Padding}"
                                 Margin="0,0,26,0"
                                 MinHeight="0"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{DynamicResource Brush.Text}"
                                 SelectionBrush="{DynamicResource Brush.Accent}"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade"
                               MinWidth="{TemplateBinding ActualWidth}">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="4" Margin="0,4,0,0"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="False" />
                                <Condition Property="SelectedItem" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selected" Property="Visibility" Value="Collapsed" />
                            <!-- A field you type into is a caret, not a hand. -->
                            <Setter Property="Cursor" Value="IBeam" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBox.Mono" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
    </Style>

    <!-- ============================== Tabs ============================== -->

    <!-- A segmented control rather than a filing-cabinet tab strip: two destinations, one visible
         selection, and the same 7px radius as the buttons beside it. -->
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="7"
                            Padding="15,6" Margin="1,0" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="9" Padding="3" Margin="0,0,0,10">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== Scroll bars ========================== -->

    <Style x:Key="ScrollBar.PageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bar"
                            Background="{DynamicResource Brush.Scroll}"
                            CornerRadius="3"
                            Margin="3"
                            Opacity="0.55" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.95" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBar.PageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBar.PageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBar.PageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBar.PageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Lists ============================= -->

    <Style x:Key="EntryItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                            Padding="9,5" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selected}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EntryList" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource EntryItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    </Style>

    <!-- Distinct values: data out of the cluster, so monospaced and never wrapped, with the full
         string on the tooltip because a long one is trimmed rather than reflowed. -->
    <Style x:Key="ValueItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource EntryItem}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
        <Setter Property="ToolTip" Value="{Binding}" />
    </Style>

    <Style x:Key="ValueList" TargetType="{x:Type ListBox}" BasedOn="{StaticResource EntryList}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource ValueItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ============================= Data grid ========================== -->

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <!-- Both grippers, so dragging a column edge still resizes it. -->
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6"
                               Cursor="SizeWE" Opacity="0" Background="Transparent" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6"
                               Cursor="SizeWE" Opacity="0" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="Transparent" Padding="10,0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRow}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <DataGridCellsPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <!-- ============================ Expander ============================ -->

    <!-- Used for the diagnostics report: present whenever there is one, open only when asked for. -->
    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel>
                        <ToggleButton x:Name="Header" DockPanel.Dock="Top"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Cursor="Hand" Focusable="False"
                                      HorizontalAlignment="Left">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                                            Padding="6,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chevron" Text="&#xE76C;"
                                                       FontFamily="{StaticResource Font.Icons}" FontSize="9"
                                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"
                                                       RenderTransformOrigin="0.5,0.5" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- A whole transform rather than an Angle: a Freezable
                                             named inside a template is not in its namescope, so
                                             the trigger has to target the element that holds it. -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Progress =========================== -->

    <!--
        Three pulsing dots rather than a sliding bar. Every long operation in this app has an
        unknown duration — a schema analysis over "all documents" can be one second or ninety — and
        a bar that fills at a rate it invented is a promise the app cannot keep. Dots say "still
        working" and nothing more.
    -->
    <Style x:Key="Busy" TargetType="{x:Type ProgressBar}">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot1" Width="6" Height="6" Margin="1,0"
                                 Fill="{TemplateBinding Foreground}" Opacity="0.25" />
                        <Ellipse x:Name="Dot2" Width="6" Height="6" Margin="1,0"
                                 Fill="{TemplateBinding Foreground}" Opacity="0.25" />
                        <Ellipse x:Name="Dot3" Width="6" Height="6" Margin="1,0"
                                 Fill="{TemplateBinding Foreground}" Opacity="0.25" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Dot1"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.25" To="1" Duration="0:0:0.45"
                                                         AutoReverse="True" BeginTime="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="Dot2"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.25" To="1" Duration="0:0:0.45"
                                                         AutoReverse="True" BeginTime="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Dot3"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.25" To="1" Duration="0:0:0.45"
                                                         AutoReverse="True" BeginTime="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The presence bar in the schema grid. A field seen in 998 of 1000 documents and one seen in
        11 both read as "Optional" in the requirement column; the bar is what separates them without
        having to compare two four-digit numbers.
    -->
    <Style x:Key="PresenceTrack" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource Brush.Track}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="54" />
    </Style>

    <Style x:Key="PresenceFill" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRequired}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Ok}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- =========================== Miscellany =========================== -->

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="7" Padding="9,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drag handle between two panes. Invisible until the pointer is on it, then a short bar
         in the middle of the run rather than a full-height line. -->
    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Width="3" Height="34" CornerRadius="2"
                                Background="{DynamicResource Brush.Border}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1" />
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="ResizeDirection" Value="Rows">
                            <Setter TargetName="Grip" Property="Width" Value="34" />
                            <Setter TargetName="Grip" Property="Height" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
